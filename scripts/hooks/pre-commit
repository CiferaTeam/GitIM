#!/usr/bin/env bash
# Pre-commit hook: enforce cargo fmt + warning-free cargo clippy on the whole workspace.
# Install via: scripts/install-hooks.sh
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "==> cargo fmt --all -- --check"
if ! cargo fmt --all -- --check; then
  echo
  echo "ERROR: cargo fmt found unformatted code. Run 'cargo fmt --all' and re-stage."
  exit 1
fi

echo "==> cargo clippy --workspace --all-targets --no-deps --locked -- -D warnings"
if ! cargo clippy --workspace --all-targets --no-deps --locked -- -D warnings; then
  echo
  echo "ERROR: cargo clippy found an error or warning. Fix the diagnostics above."
  echo "       If the error mentions Cargo.lock, run 'cargo update' first."
  exit 1
fi
